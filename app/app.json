{
  "expo": {
    "name": "bookshelf",
    "slug": "bookshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bookshelf-icon.png",
    "scheme": "bookshelf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bookshelf-icon.png",
        "backgroundImage": "./assets/images/bookshelf-icon.png",
        "monochromeImage": "./assets/images/bookshelf-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vedantyadu.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bookshelf-icon.svg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
